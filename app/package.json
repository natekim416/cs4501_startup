{
  "name": "cleanasaurus",
  "version": "0.1.0",
  "description": "Local, chat-driven cleaner for developer clutter and personal files, with a validated plan loop and a rebuild proof.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "demo-files": "node scripts/make-demo-folder.js",
    "demo": "node scripts/make-demo-folder.js && electron . --demo-folder=$HOME/CleanasaurusDemo/Downloads",
    "test": "node --test test/*.test.js test/stories/*.test.js",
    "test:ui": "node scripts/ui-test.js",
    "test:todos": "node scripts/check-todos.js",
    "test:live": "node --test --test-concurrency=1 test/live/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' test/*.test.js test/stories/*.test.js",
    "dev-demo": "node scripts/make-dev-demo.js && electron . --demo-folder=$HOME/CleanasaurusDemo/code"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  }
}
